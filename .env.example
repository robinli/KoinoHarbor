NODE_ENV=development
HOST=0.0.0.0
PORT=8080
APP_NAME=Koino Harbor
AUTH_PROVIDER=development
SESSION_SECRET=replace-with-a-long-random-value

# 僅供本機 POC 使用；正式環境不可啟用 development provider。
DEV_ADMIN_EMAIL=admin@koino.local
DEV_ADMIN_PASSWORD=PocAdmin123!
DEV_MEMBER_EMAIL=member@koino.local
DEV_MEMBER_PASSWORD=PocMember123!
DEV_GUEST_EMAIL=guest@koino.local
DEV_GUEST_PASSWORD=PocGuest123!
SEED_DEVELOPMENT_DATA=true

# Firebase Web SDK 公開設定（POC-03 使用）
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin SDK 應優先使用 Application Default Credentials。
GOOGLE_APPLICATION_CREDENTIALS=

# 使用者內容自動翻譯（正式環境請使用 cloud-tasks）
TRANSLATION_PROJECT_ID=
TRANSLATION_LOCATION=global
TRANSLATION_QUEUE_MODE=inline
CLOUD_TASKS_PROJECT_ID=
CLOUD_TASKS_LOCATION=asia-east1
CLOUD_TASKS_QUEUE=koino-translations
CLOUD_TASKS_TARGET_URL=
CLOUD_TASKS_AUDIENCE=
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=
TRANSLATION_TASK_MAX_ATTEMPTS=5

