rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && currentUser().data.active == true;
    }

    function isAdmin() {
      return activeUser() && currentUser().data.role == 'admin';
    }

    function spaceNotDeleted(space) {
      return !space.data.keys().hasAny(['deletedAt']) || space.data.deletedAt == null;
    }

    function isDirectSpaceMember(spaceId, space) {
      return activeUser() && spaceNotDeleted(space)
        && space.data.accessMode == 'restricted'
        && exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid))
        && space.data.allowedRoles.hasAny([currentUser().data.role]);
    }

    function inheritsParentAccess(space) {
      return space.data.parentId != null
        && spaceNotDeleted(space)
        && space.data.accessMode == 'inherited'
        && isDirectSpaceMember(
          space.data.parentId,
          get(/databases/$(database)/documents/spaces/$(space.data.parentId))
        );
    }

    function canAccessSpace(spaceId) {
      let space = get(/databases/$(database)/documents/spaces/$(spaceId));
      return spaceNotDeleted(space) && (isDirectSpaceMember(spaceId, space) || inheritsParentAccess(space));
    }

    function validSpaceParent() {
      return request.resource.data.parentId == null
        || (exists(/databases/$(database)/documents/spaces/$(request.resource.data.parentId))
          && get(/databases/$(database)/documents/spaces/$(request.resource.data.parentId)).data.parentId == null
          && get(/databases/$(database)/documents/spaces/$(request.resource.data.parentId)).data.accessMode == 'restricted'
          && spaceNotDeleted(get(/databases/$(database)/documents/spaces/$(request.resource.data.parentId))));
    }

    function validSpaceAccessMode() {
      return (request.resource.data.parentId == null && request.resource.data.accessMode == 'restricted')
        || (request.resource.data.parentId != null
          && (request.resource.data.accessMode == 'inherited' || request.resource.data.accessMode == 'restricted'));
    }

    function validSpaceAllowedRoles() {
      return request.resource.data.allowedRoles is list
        && ((request.resource.data.accessMode == 'inherited' && request.resource.data.allowedRoles.size() == 0)
          || (request.resource.data.accessMode == 'restricted'
            && request.resource.data.allowedRoles.size() > 0
            && request.resource.data.allowedRoles.size() <= 3
            && request.resource.data.allowedRoles.toSet().size() == request.resource.data.allowedRoles.size()
            && request.resource.data.allowedRoles.hasOnly(['admin', 'member', 'guest'])));
    }

    function validSpaceSortOrder() {
      return request.resource.data.sortOrder is int
        && request.resource.data.sortOrder >= 0;
    }

    function validAuditOnCreate() {
      return request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validSpaceDeletionOnCreate() {
      return request.resource.data.keys().hasAll(['deletedAt', 'deletedBy'])
        && request.resource.data.deletedAt == null
        && request.resource.data.deletedBy == null;
    }

    function unchangedSpaceDeletion() {
      return request.resource.data.deletedAt == resource.data.deletedAt
        && request.resource.data.deletedBy == resource.data.deletedBy;
    }

    function validAuditOnUpdate() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if activeUser() && (request.auth.uid == userId || isAdmin());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() && validAuditOnUpdate();

      match /unreadMessages/{messageId} {
        allow read: if activeUser() && request.auth.uid == userId && canAccessSpace(resource.data.spaceId);
        allow create: if activeUser() && request.auth.uid == userId && canAccessSpace(request.resource.data.spaceId);
        allow update: if activeUser() && request.auth.uid == userId
          && canAccessSpace(resource.data.spaceId)
          && request.resource.data.userId == request.auth.uid;
      }
    }

    match /spaces/{spaceId} {
      allow read: if canAccessSpace(spaceId);
      allow create: if isAdmin() && validAuditOnCreate() && validSpaceDeletionOnCreate()
        && validSpaceParent() && validSpaceAccessMode() && validSpaceAllowedRoles() && validSpaceSortOrder();
      allow update: if isAdmin() && spaceNotDeleted(resource) && unchangedSpaceDeletion() && validAuditOnUpdate()
        && request.resource.data.parentId == resource.data.parentId
        && request.resource.data.accessMode == resource.data.accessMode
        && validSpaceAllowedRoles()
        && validSpaceSortOrder();
      allow delete: if false;

      match /members/{userId} {
        allow read: if spaceNotDeleted(get(/databases/$(database)/documents/spaces/$(spaceId)))
          && (isAdmin() || (activeUser() && request.auth.uid == userId));
        allow create: if isAdmin()
          && request.resource.data.userId == userId
          && request.resource.data.spaceId == spaceId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['createdAt', 'createdBy', 'spaceId', 'userId'])
          && get(/databases/$(database)/documents/users/$(userId)).data.active == true
          && spaceNotDeleted(get(/databases/$(database)/documents/spaces/$(spaceId)))
          && get(/databases/$(database)/documents/spaces/$(spaceId)).data.archived == false
          && get(/databases/$(database)/documents/spaces/$(spaceId)).data.accessMode == 'restricted'
          && get(/databases/$(database)/documents/spaces/$(spaceId)).data.allowedRoles.hasAny([
            get(/databases/$(database)/documents/users/$(userId)).data.role
          ]);
        allow delete: if isAdmin() && spaceNotDeleted(get(/databases/$(database)/documents/spaces/$(spaceId)));
        allow update: if false;
      }

      match /messageReactions/{reactionId} {
        allow read: if canAccessSpace(spaceId);
        allow create, update, delete: if false;
      }
    }

    match /threadStatuses/{statusId} {
      allow read: if activeUser() && (resource.data.active == true || isAdmin());
      allow create: if isAdmin() && validAuditOnCreate();
      allow update: if isAdmin() && validAuditOnUpdate();
      allow delete: if false;
    }

    match /threads/{threadId} {
      allow read: if canAccessSpace(resource.data.spaceId);
      allow create: if canAccessSpace(request.resource.data.spaceId)
        && request.resource.data.authorId == request.auth.uid
        && validAuditOnCreate();
      allow update: if canAccessSpace(resource.data.spaceId)
        && request.resource.data.spaceId == resource.data.spaceId
        && request.resource.data.authorId == resource.data.authorId
        && (isAdmin() || resource.data.authorId == request.auth.uid)
        && validAuditOnUpdate();
      allow delete: if false;

      match /replies/{replyId} {
        function parentThread() {
          return get(/databases/$(database)/documents/threads/$(threadId));
        }
        allow read: if canAccessSpace(parentThread().data.spaceId);
        allow create: if canAccessSpace(parentThread().data.spaceId)
          && request.resource.data.authorId == request.auth.uid
          && validAuditOnCreate();
        allow update: if canAccessSpace(parentThread().data.spaceId)
          && (isAdmin() || resource.data.authorId == request.auth.uid)
          && request.resource.data.authorId == resource.data.authorId
          && validAuditOnUpdate();
        allow delete: if false;
      }
    }

    match /attachments/{attachmentId} {
      allow read: if canAccessSpace(resource.data.spaceId);
      allow create: if canAccessSpace(request.resource.data.spaceId)
        && request.resource.data.uploadedBy == request.auth.uid
        && validAuditOnCreate();
      allow update, delete: if false;
    }

    match /users/{userId}/bookmarks/{threadId} {
      allow read, write: if activeUser() && request.auth.uid == userId;
    }
  }
}
